ticket-os.vinicius-gpl.com {
    header {
        Strict-Transport-Security "max-age=31536000;"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
    }

    # Swarm service of the hetzner_ticket-os stack, over the edge network. The API trusts one proxy
    # hop (API_TRUST_PROXY_HOPS=1), which is this Caddy.
    reverse_proxy hetzner_ticket-os_app:3000

    encode zstd gzip

    log {
        output file /data/ticket-os-access.log
        format json
    }
}
